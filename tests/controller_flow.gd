extends SceneTree
const Controller=preload("res://scripts/game_controller.gd")
var game
var failed: Array=[]
var checks:=0
func _initialize() -> void:
	call_deferred("run")
func check(ok: bool,label: String) -> void:
	checks+=1
	if not ok:failed.append(label)
func press(id: String) -> void:
	check(game.controls.has(id),"control:"+id)
	if game.controls.has(id):game.controls[id].pressed.emit()
	await process_frame
	await process_frame
func run() -> void:
	game=Controller.new();game.autosave_enabled=false;game.save_path="user://controller-test-"+str(OS.get_process_id())+".json";root.add_child(game);game.size=Vector2(1920,1080)
	await process_frame
	check(game.screen=="menu","start menu")
	await press("menu_0")
	check(game.screen=="intro","new game")
	await press("intro_next")
	check(game.screen=="tutorial","intro next")
	await press("tutorial_next")
	check(game.model.state.tutorialPage==1,"tutorial page2")
	await press("tutorial_back")
	check(game.model.state.tutorialPage==0,"tutorial back")
	await press("tutorial_skip")
	check(game.screen=="loadout","loadout route")
	await press("carrier_1")
	await press("item_rice5")
	check("rice5" in game.model.state.loadout.assigned["母亲"],"assign item")
	await press("recommend")
	check(game.model.state.loadout.confirmRecommendation,"confirm required")
	await press("recommend_cancel")
	check(game.model.state.loadout.assigned["母亲"]==["rice5"],"cancel preserves selection")
	await press("recommend")
	await press("recommend_confirm")
	check(game.model.validate_bags(),"recommended bags valid")
	await press("clear")
	check(game.model.assigned_ids().is_empty(),"clear bags")
	await press("pool_down")
	check(game.pool_row==1,"scroll inside supply grid")
	await press("depart")
	check(game.screen=="event","opening road")
	check(game.controls.choice_1.disabled,"rope unavailable without pack")
	await press("choice_0")
	check(game.model.state.memory.opening.choice==0,"choice committed")
	await press("result_next")
	check(game.screen=="report","arrival settled")
	await press("result_next")
	check(game.screen=="diary","opening diary")
	await press("night_plan")
	check(game.screen=="night","night planning route")
	await press("night_meal_off")
	await press("night_fire_0")
	check(not game.controls.night_confirm.disabled,"empty stock valid no cook plan")
	await press("night_confirm")
	check(game.screen=="nightEvent","night reading route")
	await press("night_read_next")
	check(game.controls.night_choice_whistle.disabled,"no whistle disabled")
	var before_reread=game.model.state.duplicate(true)
	await press("night_reread")
	await press("night_read_next")
	check(game.model.state==before_reread,"reread does not settle or alter state")
	await press("night_choice_quiet")
	await press("night_finish")
	check(game.screen=="morning","morning route")
	check(game.model.state.day==1,"next morning day")
	await press("morning_report")
	await press("morning_city")
	check(not game.controls.morning_next.disabled,"day two focus available")
	var morning_state: Dictionary=game.model.state.duplicate(true)
	game.open_saves();game.render_screen();await process_frame
	check(game.screen=="save" and game.controls.save_restore.disabled,"save management initial")
	await press("save_write")
	check(FileAccess.file_exists(game.save_path),"manual save exists")
	game.model.state.rice+=1
	await press("save_read")
	check(game.model.state.rice==morning_state.rice+1,"preview is readonly")
	check(not game.controls.save_restore.disabled,"valid preview enables restore")
	game.save_editor.text="bad";game.save_editor.text_changed.emit()
	check(game.controls.save_restore.disabled,"editing invalidates stale preview")
	await press("save_validate")
	check(game.controls.save_restore.disabled,"invalid input blocked")
	await press("save_read")
	await press("save_restore")
	check(game.screen=="morning" and game.model.state==morning_state,"confirmed restore")
	check(FileAccess.file_exists(game.save_path+".before-restore"),"unsaved progress backed up")
	await press("morning_next")
	check(game.screen=="focus","day two plan")
	await press("focus_back")
	check(game.screen=="morning","plan back does not settle")
	await press("morning_next")
	await press("focus_confirm")
	check(game.screen=="focusEvent","day two event")
	await press("focus_event_back")
	await press("focus_confirm")
	await press("focus_choice_2")
	check(game.screen=="focusResult","day two result")
	game.open_saves();game.render_screen();await process_frame
	await press("save_write")
	check(game.save_store.error=="","save day two result")
	await press("save_back")
	await press("focus_result_next")
	check(game.screen=="focusReturn","day two evening")
	await press("focus_return_diary")
	check(game.screen=="focusDiary","day two diary")
	await press("day_open_night")
	await press("night_meal_off")
	await press("night_fire_0")
	await press("night_confirm")
	check(game.screen=="nightEvent","second night confirmed")
	if game.model.state.pendingNightEvent!=null:
		if game.model.state.pendingNightEvent.type=="family":await press("night_family_continue")
		else:
			await press("night_read_next")
			var kind: String=game.model.state.pendingNightEvent.type
			await press("night_choice_"+({"theft":"quiet","robbery":"give","mouse":"wait"}[kind]))
	await press("night_finish")
	check(game.screen=="morning" and game.model.state.day==2,"third morning")
	check(game.controls.morning_next.disabled==not game.first_day_focus_available(),"third day eligibility reflects actual health")
	check(game.load_errors.is_empty(),"resources")
	for suffix in ["",".bak",".tmp",".bak.tmp",".before-restore",".before-restore.bak"]:
		if FileAccess.file_exists(game.save_path+suffix):DirAccess.remove_absolute(game.save_path+suffix)
	print(JSON.stringify({"checks":checks,"failed":failed,"visual_test":false,"full_game":false}))
	game.queue_free();await process_frame;quit(0 if failed.is_empty() else 1)
